# Local development only. Replace the placeholder; never reuse it outside a local database.
AUTH_DATABASE__URL=postgresql+asyncpg://authservice:replace-with-local-password@127.0.0.1:5432/authservice
AUTH_DATABASE__POOL_SIZE=5
AUTH_DATABASE__MAX_OVERFLOW=5
AUTH_DATABASE__POOL_TIMEOUT_SECONDS=10
AUTH_DATABASE__COMMAND_TIMEOUT_SECONDS=10

AUTH_APPLICATION__ENVIRONMENT=development
AUTH_APPLICATION__VERSION=0.1.0
AUTH_HTTP__HOST=127.0.0.1
AUTH_HTTP__PORT=8000

AUTH_OPENAPI_REGISTRY__MAX_DOCUMENT_BYTES=1048576
AUTH_OPENAPI_REGISTRY__MAX_OPERATIONS=1000
AUTH_OPENAPI_REGISTRY__MAX_NESTING_DEPTH=64

AUTH_OAUTH2__MAX_REQUESTED_SCOPES=128
AUTH_OAUTH2__MAX_SCOPE_TOKEN_LENGTH=255
AUTH_OAUTH2__MAX_TOTAL_SCOPE_CLAIM_BYTES=16384
AUTH_OAUTH2__MAX_ACCESS_TOKEN_BYTES=24576

AUTH_RATE_LIMIT__PASSWORD_ATTEMPTS=10
AUTH_RATE_LIMIT__PASSWORD_WINDOW_SECONDS=300
AUTH_RATE_LIMIT__PASSWORD_LOCK_SECONDS=900
AUTH_RATE_LIMIT__SERVICE_CREDENTIAL_ATTEMPTS=20
AUTH_RATE_LIMIT__SERVICE_CREDENTIAL_WINDOW_SECONDS=300
AUTH_RATE_LIMIT__SERVICE_CREDENTIAL_LOCK_SECONDS=900

AUTH_MAINTENANCE__CLEANUP_BATCH_SIZE=500
AUTH_MAINTENANCE__SECURITY_STATE_RETENTION_DAYS=30
AUTH_MAINTENANCE__AUDIT_RETENTION_DAYS=365

AUTH_PASSWORD__TIME_COST=3
AUTH_PASSWORD__MEMORY_COST_KIB=65536
AUTH_PASSWORD__PARALLELISM=4
AUTH_PASSWORD__HASH_LENGTH=32
AUTH_PASSWORD__SALT_LENGTH=16

AUTH_SESSION__IDLE_TTL_SECONDS=86400
AUTH_SESSION__ABSOLUTE_TTL_SECONDS=2592000

AUTH_REFRESH_TOKEN__TTL_SECONDS=604800
AUTH_REFRESH_TOKEN__PEPPER=replace-with-at-least-32-random-secret-bytes

AUTH_SERVICE_AUTH__ACCESS_TOKEN_TTL_SECONDS=300
AUTH_SERVICE_AUTH__CREDENTIAL_TTL_SECONDS=7776000
AUTH_SERVICE_AUTH__CREDENTIAL_PEPPER=replace-with-a-distinct-at-least-32-byte-secret

AUTH_JWT__ISSUER=authService
AUTH_JWT__HUMAN_AUDIENCE=authService
AUTH_JWT__ACCESS_TOKEN_TTL_SECONDS=600
AUTH_JWT__CLOCK_SKEW_SECONDS=30
AUTH_JWT__ACTIVE_KID=key-20260822-a
AUTH_JWT__ACTIVE_PRIVATE_KEY_PATH=.local-secrets/auth/active-private.pem
AUTH_JWT__RETAINED_PUBLIC_KEY_DIRECTORY=.local-secrets/auth/public
AUTH_JWT__JWKS_CACHE_TTL_SECONDS=60

AUTH_LOGFIRE__ENABLED=true
AUTH_LOGFIRE__SEND_TO_LOGFIRE=false
AUTH_LOGFIRE__CONSOLE=true
AUTH_LOGFIRE__MINIMUM_LEVEL=info
# AUTH_LOGFIRE__TOKEN=replace-with-a-Logfire-write-token
