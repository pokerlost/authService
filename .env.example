AUTHSERVICE_APPLICATION__ENVIRONMENT=development
AUTHSERVICE_APPLICATION__VERSION=0.1.0
AUTHSERVICE_HTTP__HOST=127.0.0.1
AUTHSERVICE_HTTP__PORT=8000

AUTHSERVICE_LOGFIRE__ENABLED=true
AUTHSERVICE_LOGFIRE__SEND_TO_LOGFIRE=false
AUTHSERVICE_LOGFIRE__CONSOLE=true
AUTHSERVICE_LOGFIRE__MINIMUM_LEVEL=info
# AUTHSERVICE_LOGFIRE__TOKEN=replace-with-a-Logfire-write-token

# Local development only. Replace the placeholder; never reuse it outside a local database.
AUTHSERVICE_DATABASE__URL=postgresql+asyncpg://authservice:replace-with-local-password@127.0.0.1:5432/authservice
AUTHSERVICE_DATABASE__POOL_SIZE=5
AUTHSERVICE_DATABASE__MAX_OVERFLOW=5
AUTHSERVICE_DATABASE__POOL_TIMEOUT_SECONDS=10
AUTHSERVICE_DATABASE__COMMAND_TIMEOUT_SECONDS=10
