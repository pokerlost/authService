# Deployment environment is independent from Git branches and telemetry.
AUTHSERVICE_RUNTIME_ENVIRONMENT=local
# Execution contour for telemetry: local, dev, ci or remote.
AUTHSERVICE_ENVIRONMENT=local
# Example values only. The application does not load this file automatically.
AUTHSERVICE_LOGLEVEL=INFO
DATABASE_URL=postgresql+asyncpg://authservice:replace-with-local-password@127.0.0.1:5432/authservice
