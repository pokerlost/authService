# Local development only. Replace the placeholder; never reuse it outside a local database.
AUTH_DATABASE__URL=postgresql+asyncpg://authservice:replace-with-local-password@127.0.0.1:5432/authservice
AUTH_DATABASE__POOL_SIZE=5
AUTH_DATABASE__MAX_OVERFLOW=5
AUTH_DATABASE__POOL_TIMEOUT_SECONDS=10
AUTH_DATABASE__COMMAND_TIMEOUT_SECONDS=10

AUTH_APPLICATION__ENVIRONMENT=development
AUTH_HTTP__HOST=127.0.0.1
AUTH_HTTP__PORT=8000
AUTH_HTTP__OPENAPI_ENABLED=true

AUTH_LOGFIRE__SEND_TO_LOGFIRE=false
AUTH_LOGFIRE__CONSOLE_ENABLED=true
# AUTH_LOGFIRE__TOKEN=replace-with-a-Logfire-write-token
